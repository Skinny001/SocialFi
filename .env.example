# BOT Chain Testnet (chain ID 968)
NEXT_PUBLIC_RPC=https://testnet-rpc.botanixlabs.com
NEXT_PUBLIC_CHAIN_ID=968
NEXT_PUBLIC_SOCIAL_ADDRESS=0x0000000000000000000000000000000000000000

# Deployment only — never expose this in NEXT_PUBLIC_* variables.
# PRIVATE_KEY=your_deployer_private_key

# Contract deployment command inputs:
# RPC_URL=https://testnet-rpc.botanixlabs.com
# INITIAL_OWNER=your_wallet_address
# CONTRACT_ADDRESS=deployed_contract_address

# Frontend setup:
# 1. Copy this file to .env.local
# 2. Deploy contracts/src/SocialFi.sol with Foundry and OpenZeppelin
# 3. Replace NEXT_PUBLIC_SOCIAL_ADDRESS with the deployed address
# 4. Fund the reward pool from the owner wallet
# 5. Add the BOT Chain Testnet network to your wallet
